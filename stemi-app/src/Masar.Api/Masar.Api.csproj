<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- user-secrets id for local development (dotnet user-secrets set "Prototype:CrewTestUser:Password" "…") -->
    <UserSecretsId>masar-stemi-prototype</UserSecretsId>
    <!-- The screens are served by FrontendFiles from Frontend:RootPath (Program.cs), not by the SDK's "static web
         assets" feature, which would expect a wwwroot folder in this project during development. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masar.Infrastructure\Masar.Infrastructure.csproj" />
    <ProjectReference Include="..\Masar.Application\Masar.Application.csproj" />
    <ProjectReference Include="..\Masar.Domain\Masar.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The screens (HTML, CSS, JavaScript) live in the repository's public/ folder. A published build carries them in
       wwwroot (Frontend:RootPath = wwwroot, the default); in development they are served from public/ directly. -->
  <ItemGroup>
    <Content Include="..\..\public\**\*" LinkBase="wwwroot" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
