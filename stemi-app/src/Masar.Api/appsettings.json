{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:3000"
      }
    }
  },
  "Frontend": {
    "RootPath": "wwwroot"
  },
  "Storage": {
    "DataDirectory": "data",
    "DatabaseFileName": "stemi-test.db",
    "MaxImageBytes": 8388608
  },
  "Sessions": {
    "CrewSessionHours": 24,
    "DeviceSessionDays": 30,
    "RequireSecureCookies": false
  },
  "Live": {
    "HeartbeatMs": 5000,
    "OfflineAfterMs": 8000
  },
  "Ai": {
    "Provider": "mock",
    "MockDelayMs": 5000
  },
  "Corpuls": {
    "Provider": "mock",
    "SimTickMs": 5000,
    "SimNibpSeconds": 120,
    "SimConnectMs": 800,
    "DemoMode": true,
    "DemoEcgSeconds": 3
  },
  "Prototype": {
    "CrewTestUser": {
      "Email": "crew@test.local"
    }
  }
}
