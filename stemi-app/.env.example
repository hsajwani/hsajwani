# Copy to .env and adjust. TEST BUILD: fictional data only. Never put real secrets or patient data here.

# Port the server listens on. The iPhone opens http://<this computer's IP>:PORT/cardiologist (the ER: …/er)
PORT=3000
# 0.0.0.0 makes the server reachable from other devices on the same Wi-Fi (needed for the iPhone)
HOST=0.0.0.0

# Password of the crew test user (crew@test.local). Test only. The ER Doctor and Cardiologist screens need no login:
# the clinician types their name (prototype identification only, not authentication).
TEST_USER_PASSWORD=stemi-test

# Signs the crew login cookie and the ER / cardiologist / console device sessions. Leave empty and a random one is
# generated in data/.session-secret
SESSION_SECRET=
SESSION_HOURS=24

# Where the SQLite test database and the stored ECG images live
DATA_DIR=data

# ECG AI service behind server/ai/. Only "mock" (simulated, scripted results) exists in this build.
AI_PROVIDER=mock
# How long the mock AI "processes" before its result appears (milliseconds)
MOCK_AI_DELAY_MS=5000

# Live-link heartbeat (milliseconds). Screens show CONNECTION LOST when heartbeats stop arriving.
HEARTBEAT_MS=5000

# Largest ECG image accepted (bytes)
MAX_IMAGE_BYTES=8388608

# Development runner (npm run dev:bg): when true, the runner fast-forwards this checkout from GitHub every 30 s while
# there are no local edits, so changes pushed by Claude Code arrive on this Mac without a manual git pull.
# The server then restarts by itself for backend changes; refresh the browser for screen changes.
DEV_AUTO_PULL=false
