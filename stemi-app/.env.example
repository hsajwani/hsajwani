# Settings for the development runner (npm run dev / dev:bg). Copy to .env and adjust. DEVELOPMENT ONLY.
# TEST BUILD: fictional data only. Never put real secrets, real credentials or patient data in this file or in git.
#
# The backend is the ASP.NET Core application (src/Masar.Api). It reads standard .NET configuration: appsettings.json,
# appsettings.{Environment}.json, then environment variables such as Corpuls__DemoMode=false (docs/configuration.md).
# The development runner reads this .env and translates these prototype names to the .NET keys (scripts/lib/dotnet.js).

# Port the server listens on. The iPhone opens http://<this computer's IP>:PORT/cardiologist (the ER: …/er)
PORT=3000
# 0.0.0.0 makes the server reachable from other devices on the same Wi-Fi (needed for the iPhone)
HOST=0.0.0.0

# Password of the crew test user (crew@test.local) — PROTOTYPE ONLY, fictional test account. Leave it unset and a random
# password is generated once in data/crew-test-password.txt (never printed). The ER Doctor and Cardiologist screens need
# no login: the clinician types their name (prototype identification only, not authentication).
#TEST_USER_PASSWORD=
SESSION_HOURS=24

# Where the SQLite test database (SQLite — PROTOTYPE DATABASE), the ECG images and the session keys live
DATA_DIR=data

# ECG AI service. Only "mock" (Simulated AI Interpretation — PROTOTYPE ONLY, scripted results) exists in this build.
AI_PROVIDER=mock
# How long the mock AI "processes" before its result appears (milliseconds)
MOCK_AI_DELAY_MS=5000

# Monitor feed. "mock" = Mock Corpuls Provider — PROTOTYPE ONLY (simulated monitors, no network).
# "corpuls-mission" = the placeholder for the real corpuls.mission interface: NOT implemented (no network call; every
# case stays WAITING FOR CORPULS and the manual ECG fallback is the only path).
CORPULS_PROVIDER=mock
# The simulated monitor: one vital-signs update every CORPULS_SIM_TICK_MS (also the expected interval behind the
# screens' technical freshness indicator), a blood pressure measurement every CORPULS_SIM_NIBP_SECONDS.
# Simulation settings, not clinical ones.
CORPULS_SIM_TICK_MS=5000
CORPULS_SIM_NIBP_SECONDS=120
# How long the simulated monitor takes to connect after LINK CORPULS (milliseconds)
CORPULS_SIM_CONNECT_MS=800
# The prototype demo (simulated provider only): LINK CORPULS starts a fresh simulated feed that connects, sends live
# values and, CORPULS_DEMO_ECG_SECONDS after CORPULS CONNECTED, ECG 1 by itself; the crew can simulate a requested
# repeat ECG. false: the simulated monitor does only what the test console's CORPULS SIMULATOR tells it.
CORPULS_DEMO_MODE=true
CORPULS_DEMO_ECG_SECONDS=3

# Live-link heartbeat (milliseconds). Screens show CONNECTION LOST when heartbeats stop arriving.
HEARTBEAT_MS=5000

# Largest ECG image accepted (bytes)
MAX_IMAGE_BYTES=8388608

# Development runner: when true, the runner fast-forwards this checkout from GitHub every 30 s while there are no local
# edits, so changes pushed by Claude Code arrive on this computer without a manual git pull. The server then rebuilds and
# restarts by itself for backend changes; refresh the browser for screen changes.
DEV_AUTO_PULL=false

# LEGACY: "node" runs the Node.js server of the prototype (server/) instead of the ASP.NET Core backend — the transition
# fallback only (also used automatically when the .NET SDK is not installed).
#STEMI_BACKEND=node
